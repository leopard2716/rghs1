{
  "name": "@rghs1/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n pages,content -c cyan,green \"vite build --watch\" \"vite build --watch --config vite.content.config.ts\"",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src vite.config.ts vite.content.config.ts --max-warnings=0",
    "lint:fix": "eslint src vite.config.ts vite.content.config.ts --fix",
    "test": "vitest run",
    "eval": "vitest run src/evals"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "vitest": "^3.2.4",
    "typescript": "^5.8.3"
  }
}
