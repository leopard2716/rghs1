{
  "manifest_version": 3,
  "name": "RGHS1 Apply Assistant",
  "version": "0.1.0",
  "description": "Extract job pages, review tailored resumes, and assist form filling through RGHS1.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RGHS1 Apply Assistant"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://*.workers.dev/*"
  ],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
