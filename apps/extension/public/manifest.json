{
  "manifest_version": 3,
  "name": "RGHS1 Apply Assistant",
  "version": "0.1.0",
  "description": "Extract job pages, review tailored resumes, and assist form filling through RGHS1.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RGHS1 Apply Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost/*",
    "https://rghs1-api-dev.rghs1.workers.dev/*",
    "https://rghs1-api-prod.rghs1.workers.dev/*"
  ],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
